{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: Debug (Live TypeScript)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "env": {
        "TS_NODE_FILES": "true"
      }
    }
  ]
}
